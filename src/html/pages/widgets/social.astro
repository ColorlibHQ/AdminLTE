---
import Head from "@components/_head.astro"
import Footer from "@components/dashboard/_footer.astro"
import Topbar from "@components/dashboard/_topbar.astro"
import Sidenav from "@components/dashboard/_sidenav.astro"
import Scripts from "@components/_scripts.astro"

const title = "AdminLTE 4 | Widgets - Social & Post"
const path = "../../../dist"
const mainPage = "widgets"
const page = "social"
const pageTitle = "Social & Post Widgets"

// Smart path resolution: calculate relative path based on directory depth
const pathname = Astro.url.pathname
const pathSegments = pathname.split("/").filter(segment => segment !== "")
const depth = pathSegments.length > 0 ? pathSegments.length - 1 : 0
const deploymentPath = depth === 0 ? "./" : "../".repeat(depth)
---

<!doctype html>
<html lang="en">
  <!--begin::Head-->
  <head>
    <Head title={title} path={path} />
  </head>
  <!--end::Head-->
  <!--begin::Body-->
  <body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
    <!--begin::App Wrapper-->
    <div class="app-wrapper">
      <Topbar path={path} />
      <Sidenav path={path} mainPage={mainPage} page={page} />
      <!--begin::App Main-->
      <main class="app-main">
        <!--begin::App Content Header-->
        <div class="app-content-header">
          <!--begin::Container-->
          <div class="container-fluid">
            <!--begin::Row-->
            <div class="row">
              <div class="col-sm-6">
                <h1 class="mb-0 fs-3">{pageTitle}</h1>
              </div>
              <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a href="#">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">
                      {pageTitle}
                    </li>
                  </ol>
                </nav>
              </div>
            </div>
            <!--end::Row-->
          </div>
          <!--end::Container-->
        </div>
        <!--end::App Content Header-->
        <!--begin::App Content-->
        <div class="app-content">
          <!--begin::Container-->
          <div class="container-fluid">
            <!--begin::User Widgets-->
            <h5 class="mb-3">User widgets</h5>
            <!--begin::Row-->
            <div class="row g-4">
              <!--begin::Col-->
              <div class="col-lg-6">
                <!--begin::Widget User-->
                <div class="card widget-user mb-0">
                  <!--begin::Widget User Header-->
                  <div class="widget-user-header text-bg-primary">
                    <h3 class="widget-user-username">Elizabeth Pierce</h3>
                    <h5 class="widget-user-desc">Web Designer</h5>
                  </div>
                  <!--end::Widget User Header-->
                  <div class="widget-user-image">
                    <img
                      class="rounded-circle shadow"
                      src={deploymentPath + "assets/img/user3-128x128.jpg"}
                      alt=""
                    />
                  </div>
                  <!--begin::Card Footer-->
                  <div class="card-footer">
                    <!--begin::Row-->
                    <div class="row">
                      <div class="col-sm-4 border-end">
                        <div class="description-block">
                          <p class="description-header">3,200</p>
                          <span class="description-text">Sales</span>
                        </div>
                      </div>
                      <div class="col-sm-4 border-end">
                        <div class="description-block">
                          <p class="description-header">13,000</p>
                          <span class="description-text">Followers</span>
                        </div>
                      </div>
                      <div class="col-sm-4">
                        <div class="description-block">
                          <p class="description-header">35</p>
                          <span class="description-text">Products</span>
                        </div>
                      </div>
                    </div>
                    <!--end::Row-->
                  </div>
                  <!--end::Card Footer-->
                </div>
                <!--end::Widget User-->
              </div>
              <!--end::Col-->
              <!--begin::Col-->
              <div class="col-lg-6">
                <!--begin::Widget User 2-->
                <div class="card widget-user-2 mb-0">
                  <!--begin::Widget User Header-->
                  <div class="widget-user-header text-bg-warning">
                    <div class="widget-user-image">
                      <img
                        class="rounded-circle shadow"
                        src={deploymentPath + "assets/img/user7-128x128.jpg"}
                        alt=""
                      />
                    </div>
                    <div>
                      <h3 class="widget-user-username">Nadia Carmichael</h3>
                      <h5 class="widget-user-desc">Lead Developer</h5>
                    </div>
                  </div>
                  <!--end::Widget User Header-->
                  <!--begin::Card Footer-->
                  <div class="card-footer p-0">
                    <ul class="nav flex-column">
                      <li class="nav-item">
                        <a href="#" class="nav-link link-body-emphasis">
                          Projects
                          <span class="float-end badge text-bg-primary">31</span>
                        </a>
                      </li>
                      <li class="nav-item">
                        <a href="#" class="nav-link link-body-emphasis">
                          Tasks
                          <span class="float-end badge text-bg-info">5</span>
                        </a>
                      </li>
                      <li class="nav-item">
                        <a href="#" class="nav-link link-body-emphasis">
                          Completed Projects
                          <span class="float-end badge text-bg-success">12</span>
                        </a>
                      </li>
                      <li class="nav-item">
                        <a href="#" class="nav-link link-body-emphasis">
                          Followers
                          <span class="float-end badge text-bg-danger">842</span>
                        </a>
                      </li>
                    </ul>
                  </div>
                  <!--end::Card Footer-->
                </div>
                <!--end::Widget User 2-->
              </div>
              <!--end::Col-->
            </div>
            <!--end::Row-->
            <!--end::User Widgets-->

            <!--begin::Social & Post-->
            <h5 class="mb-3 mt-4">Social feed</h5>
            <!--begin::Row-->
            <div class="row g-4">
              <!--begin::Col-->
              <div class="col-lg-6">
                <!--begin::Social Widget-->
                <div class="card mb-0">
                  <!--begin::Card Header-->
                  <div class="card-header">
                    <div class="user-block">
                      <img
                        class="rounded-circle"
                        src={deploymentPath + "assets/img/user1-128x128.jpg"}
                        alt=""
                      />
                      <span class="username">
                        <a href="#">Jonathan Burke Jr.</a>
                      </span>
                      <span class="description">Shared publicly &middot; 7:30 PM today</span>
                    </div>
                    <div class="card-tools">
                      <button
                        type="button"
                        class="btn btn-tool"
                        data-lte-toggle="card-collapse"
                        aria-label="Collapse card"
                      >
                        <i data-lte-icon="expand" class="bi bi-plus-lg"></i>
                        <i data-lte-icon="collapse" class="bi bi-dash-lg"></i>
                      </button>
                    </div>
                  </div>
                  <!--end::Card Header-->
                  <!--begin::Card Body-->
                  <div class="card-body">
                    <img
                      class="img-fluid rounded mb-3"
                      src={deploymentPath + "assets/img/photo1.png"}
                      alt=""
                    />
                    <p>
                      I took this photo this morning. What do you guys think?
                    </p>
                    <button type="button" class="btn btn-sm btn-outline-secondary me-1">
                      <i class="bi bi-share me-1" aria-hidden="true"></i> Share
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary">
                      <i class="bi bi-hand-thumbs-up me-1" aria-hidden="true"></i> Like
                    </button>
                    <span class="float-end text-secondary">45 likes &middot; 2 comments</span>
                  </div>
                  <!--end::Card Body-->
                  <!--begin::Card Footer-->
                  <div class="card-footer">
                    <div class="user-block user-block-sm mb-3">
                      <img
                        class="rounded-circle"
                        src={deploymentPath + "assets/img/user4-128x128.jpg"}
                        alt=""
                      />
                      <span class="username"><a href="#">Maria Gonzales</a></span>
                      <span class="description">Posted 5 minutes ago</span>
                      <span class="comment">
                        It is a long established fact that a reader will be
                        distracted by the readable content of a page.
                      </span>
                    </div>
                    <div class="user-block user-block-sm">
                      <img
                        class="rounded-circle"
                        src={deploymentPath + "assets/img/user5-128x128.jpg"}
                        alt=""
                      />
                      <span class="username"><a href="#">Nora Havisham</a></span>
                      <span class="description">Posted 27 minutes ago</span>
                      <span class="comment">
                        The point of using Lorem Ipsum is that it has a
                        more-or-less normal distribution of letters.
                      </span>
                    </div>
                    <!--begin::Comment Form-->
                    <form class="mt-3">
                      <label for="social-comment" class="visually-hidden">
                        Write a comment
                      </label>
                      <input
                        type="text"
                        id="social-comment"
                        class="form-control form-control-sm"
                        placeholder="Type a comment"
                      />
                    </form>
                    <!--end::Comment Form-->
                  </div>
                  <!--end::Card Footer-->
                </div>
                <!--end::Social Widget-->
              </div>
              <!--end::Col-->
              <!--begin::Col-->
              <div class="col-lg-6">
                <!--begin::Post Widget-->
                <div class="card mb-0">
                  <!--begin::Card Header-->
                  <div class="card-header">
                    <div class="card-title">Latest activity</div>
                  </div>
                  <!--end::Card Header-->
                  <!--begin::Card Body-->
                  <div class="card-body">
                    <!--begin::Post-->
                    <div class="post">
                      <div class="user-block">
                        <img
                          class="rounded-circle"
                          src={deploymentPath + "assets/img/user1-128x128.jpg"}
                          alt=""
                        />
                        <span class="username"><a href="#">Jonathan Burke Jr.</a></span>
                        <span class="description">Shared publicly &middot; 7:30 PM today</span>
                      </div>
                      <p>
                        Lorem ipsum represents a long-held tradition for
                        designers, typographers and the like.
                      </p>
                      <p class="mb-0">
                        <a href="#" class="link-secondary me-2">
                          <i class="bi bi-share me-1" aria-hidden="true"></i> Share
                        </a>
                        <a href="#" class="link-secondary">
                          <i class="bi bi-hand-thumbs-up me-1" aria-hidden="true"></i> Like
                        </a>
                      </p>
                    </div>
                    <!--end::Post-->
                    <!--begin::Post-->
                    <div class="post">
                      <div class="user-block">
                        <img
                          class="rounded-circle"
                          src={deploymentPath + "assets/img/user7-128x128.jpg"}
                          alt=""
                        />
                        <span class="username"><a href="#">Sarah Ross</a></span>
                        <span class="description">Sent you a message &middot; 3 days ago</span>
                      </div>
                      <p>
                        Sed ut perspiciatis unde omnis iste natus error sit
                        voluptatem accusantium doloremque laudantium.
                      </p>
                      <p class="mb-0">
                        <a href="#" class="link-secondary me-2">
                          <i class="bi bi-share me-1" aria-hidden="true"></i> Share
                        </a>
                        <a href="#" class="link-secondary">
                          <i class="bi bi-hand-thumbs-up me-1" aria-hidden="true"></i> Like
                        </a>
                      </p>
                    </div>
                    <!--end::Post-->
                    <!--begin::Post-->
                    <div class="post">
                      <div class="user-block">
                        <img
                          class="rounded-circle"
                          src={deploymentPath + "assets/img/user6-128x128.jpg"}
                          alt=""
                        />
                        <span class="username"><a href="#">Adam Jones</a></span>
                        <span class="description">Posted 5 photos &middot; 1 week ago</span>
                      </div>
                      <!--begin::Row-->
                      <div class="row g-2 mb-3">
                        <div class="col-4">
                          <img
                            class="img-fluid rounded"
                            src={deploymentPath + "assets/img/photo2.png"}
                            alt=""
                          />
                        </div>
                        <div class="col-4">
                          <img
                            class="img-fluid rounded"
                            src={deploymentPath + "assets/img/photo3.jpg"}
                            alt=""
                          />
                        </div>
                        <div class="col-4">
                          <img
                            class="img-fluid rounded"
                            src={deploymentPath + "assets/img/photo4.jpg"}
                            alt=""
                          />
                        </div>
                      </div>
                      <!--end::Row-->
                      <p class="mb-0">
                        <a href="#" class="link-secondary me-2">
                          <i class="bi bi-share me-1" aria-hidden="true"></i> Share
                        </a>
                        <a href="#" class="link-secondary">
                          <i class="bi bi-hand-thumbs-up me-1" aria-hidden="true"></i> Like
                        </a>
                      </p>
                    </div>
                    <!--end::Post-->
                  </div>
                  <!--end::Card Body-->
                </div>
                <!--end::Post Widget-->
              </div>
              <!--end::Col-->
            </div>
            <!--end::Row-->
            <!--end::Social & Post-->
          </div>
          <!--end::Container-->
        </div>
        <!--end::App Content-->
      </main>
      <!--end::App Main-->
      <Footer />
    </div>
    <!--end::App Wrapper-->
    <!--begin::Script-->
    <Scripts path={path} />
    <!--end::Script-->
  </body><!--end::Body-->
</html>
